# CartBack 环境变量唯一出处（走查工程建议 #1：三条启动入口的默认值以此为准）
#
# 注意：后端不内置 dotenv、不会自动读取 .env 文件 —— 这里是「变量清单 + 默认值说明」。
# 实际注入方式：export 后启动（sh/cmd）、docker-compose environment、或 CI 环境变量。
#
# 三条启动入口的当前默认：
#   scripts/start_local_dev.sh  → CARTBACK_OPEN_LOCAL 默认 1（本地开发免登录）
#   start-backend.cmd           → CARTBACK_OPEN_LOCAL 默认 1（Windows 一键启动，同上）
#   docker-compose.yml          → CARTBACK_OPEN_LOCAL 默认 0（部署默认安全模式，需注册/登录）
#
# AI/ESP 等运行配置也可在设置页填写，持久化到 backend/.server/config（页面保存优先）。

# —— 运行模式 ——
# 1 = 免登录（本地令牌对访客开放，仅限本机自用）；0 = 安全模式（必须注册/登录）
CARTBACK_OPEN_LOCAL=1

# 后端监听端口（前端 Next 反代 /api/* 到该端口）
PORT=4173

# HTTPS 反代部署时设 1（给会话 Cookie 追加 Secure 属性；本地 http 保持 0）
COOKIE_SECURE=0

# —— 服务端运行配置（lib/config.js 环境变量覆盖层）——
# 重启后对这些字段优先于设置页保存的值（config.json）；留空/不设则用 config.json 原值
# CARTBACK_MODE=demo                          # demo | real
# CARTBACK_AI_PROVIDER=tokenplan              # deepseek | tokenplan | ...
# CARTBACK_AI_KEY=sk-xxx
# CARTBACK_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CARTBACK_AI_MODEL=qwen3.7-plus
# CARTBACK_AI_EXTRA_BODY={"enable_thinking":false}
# CARTBACK_ESP_PROVIDER=smtp                  # resend | brevo | smtp
# CARTBACK_ESP_KEY=
# CARTBACK_ESP_FROM=sender@example.com
# CARTBACK_ESP_SENDER_NAME=CartBack
# CARTBACK_SMTP_HOST=smtp.163.com
# CARTBACK_SMTP_PORT=465
# CARTBACK_SMTP_USER=sender@163.com
# CARTBACK_SMTP_PASS=授权码（非登录密码）
# CARTBACK_VISION_KEY=
# CARTBACK_VISION_BASE_URL=
# CARTBACK_VISION_MODEL=wan2.7-image-pro
# CARTBACK_SHOP_DEFAULT_LOCALE=en
# CARTBACK_SHOP_BRAND=CartBack
# CARTBACK_SHOP_CART_URL=https://cartback.demo
# CARTBACK_PUBLIC_BASE_URL=
# CARTBACK_G0_WHITELIST=["品牌名","专有名词"]

# —— AI（OpenAI 兼容对话端点）——
# 对话/抽取用模型；不配 Key 时走确定性桩模型（离线可跑）
# CARTBACK_DEEPSEEK_KEY=sk-xxx
# CARTBACK_DEEPSEEK_URL=https://api.deepseek.com
# CARTBACK_DEEPSEEK_MODEL=deepseek-chat

# —— 备用/多供应商 ——
# CARTBACK_MINIMAX_KEY=
# CARTBACK_MINIMAX_URL=

# —— 图像（海报/营销图；万相兼容端点）——
# CARTBACK_WANX_KEY=
# CARTBACK_WANX_URL=
# CARTBACK_WANX_MODEL=wan2.7-image-pro

# —— 营销素材 ——
# 邮件 CTA 按钮文案 / 营销图风格提示词
# CARTBACK_CTA=Shop Now
# CARTBACK_IMAGE_STYLE=

# —— ESP 发送（真实模式；也可在设置页配置）——
# ESP 供应商：resend（默认）| brevo | smtp；Key 与发件地址建议在设置页填
#（设置页保存进 backend/.server/config，密钥不回传前端）
